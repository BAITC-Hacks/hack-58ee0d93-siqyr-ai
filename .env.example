# Скопируйте в .env. Никогда не коммитьте .env.

# --- Режимы ---
# mock | real (real = backend/agents/runner.py)
AGENT_MODE=mock
# Масштаб задержек mock-трейса: 1 = 0.3–0.8 с, 0 = без задержек (тесты)
MOCK_DELAY=1
# mock | real (real = backend/stt/engine.py, модель Alibi)
STT_MODE=mock
# live | replay (replay проигрывает сохранённый прод-ран)
DEMO_MODE=live
REPLAY_RUN_ID=

# --- LLM, OpenAI-совместимый клиент ---
# local — рабочий профиль (Ollama на этом ноутбуке); dev_openai — только синтетические запуски.
LLM_PROVIDER=local
# Обязателен для real-агентов; пусто = LLM отключена, облачного fallback нет.
# Ollama: http://127.0.0.1:11434/v1. OpenAI API — только LLM_PROVIDER=dev_openai и синтетика.
LLM_BASE_URL=
LLM_ALLOWED_HOSTS=
LLM_API_KEY=
MODEL_MAIN=gpt-6-luna
MODEL_FAST=gpt-6-luna
MODEL_EXPERT=gpt-6-luna
PRICE_IN_PER_1M=0
PRICE_OUT_PER_1M=0

# --- STT и диаризация ---
STT_MODEL_REPO=alibiserikbay/kazakh-russian-mixed-stt
# rukk | kk | ru
STT_LANG=rukk
# Токен Hugging Face для pyannote (принять условия модели на сайте)
HF_TOKEN=

# --- Бэкенд ---
DATA_DIR=data/runtime

# --- Доступ: local | hybrid | keycloak; disabled только для тестов ---
# disabled = демо без входа (JWT не нужен); local | keycloak | hybrid = с входом, нужны JWT_SECRET и bootstrap-админ
AUTH_MODE=disabled
# Сгенерируйте случайный секрет длиной >= 32 символов; не храните его в Git.
JWT_SECRET=
JWT_ISSUER=siqyr-ai
JWT_TTL_MINUTES=30
# Первый запуск создаёт системного администратора; после создания удалите пароль из окружения.
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=
# Для hybrid/keycloak: точные значения realm issuer и audience из конфигурации клиента.
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
# --- Jira: секретарь после утверждения отправляет поручения кнопкой ---
# Data Center: JIRA_URL=https://jira.company.kz, JIRA_TOKEN=<PAT>, JIRA_EMAIL пусто.
# Cloud: JIRA_EMAIL + API token (id.atlassian.com); это внешний сервис — только сценарные записи и JIRA_ALLOW_CLOUD=1.
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT=
JIRA_ISSUE_TYPE=Task
# id доски из URL .../boards/<id>: новые задачи попадают в активный спринт; пусто — в backlog
JIRA_BOARD_ID=
# Имя из протокола -> email/логин в Jira, JSON; без записи ищем по имени, неоднозначно — не назначаем
JIRA_USERS=
JIRA_ALLOW_CLOUD=
# Адрес API для ссылок «прослушать источник» в задачах; PUBLIC_APP_URL — ссылка на карточку (пусто — без неё)
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=
# Внутренний сервис проверки CMS ЭЦП; пусто = вход по ЭЦП отключён.
ECP_VERIFY_URL=
SEED=1
APP_UTC_OFFSET=5
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174
# Дополнительно localhost и 127.0.0.1 на любом порту разрешены через CORS_ORIGIN_REGEX по умолчанию.
RATE_LIMIT_PER_MIN=10
MAX_UPLOAD_MB=100
REMINDER_INTERVAL_SEC=300
REMIND_DAYS_BEFORE=1
# Сдвиг «сегодня» для демо, формат YYYY-MM-DD
DEMO_TODAY=
# Шрифт с казахскими буквами для PDF (по умолчанию ищется DejaVu Sans / Arial)
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=

# --- Фронтенд (Vite) ---
VITE_API_URL=http://localhost:8000
VITE_FAKE=1
