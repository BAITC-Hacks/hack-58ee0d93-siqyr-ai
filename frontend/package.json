{
  "name": "siqyrai-meeting-protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@mantine/core": "9.6.2",
    "@mantine/form": "9.6.2",
    "@mantine/hooks": "9.6.2",
    "@tanstack/react-query": "^5.103.2",
    "axios": "^1.20.0",
    "dexie": "4.4.6",
    "docx": "9.7.1",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
